<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/textSmsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS Notifications"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textSmsInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="This app can send an SMS when you reach your goal weight. You can allow or deny SMS permission. If denied, the app still works without SMS."
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonEnableSms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Request / Enable SMS Permission"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewSmsStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Status will appear here."
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/buttonEnableSms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonBackToGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/textViewSmsStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
